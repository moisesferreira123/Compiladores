program swapexemple
begin
  procedure swap (a: ref(int), b: ref(int))
    begin
      var tmp: int
    in
      tmp := deref(a);
      deref(a) := deref(b);
      deref(b) := tmp
    end;
  procedure main()
    begin
      var x: int;
      var y: int;
      var xr: ref(int);
      var yr: ref(int)
    in
      x := 42; y := 84;
      if x = y then
        x := x + y
      else 
        x := x*x
      fi;
      xr := ref(x);
      yr := ref(y);
      printstr("(ANTES) O valor de X é: ");
      printint(x);
      printline("");
      printstr("(ANTES) O valor de Y é: ");
      printint(y);
      swap(xr, yr);
      printline("");
      printstr("(ANTES) O valor de X é: ");
      printint(x);
      printline("");
      printstr("(ANTES) O valor de Y é: ");
      printint(y)
    end
end