program validate
begin
   var m : int := 10;
   procedure main()
      begin
         var x: int := m;
         var y := 15.6;
         var k := y + 6
      in
         x := x + m;
         y := k - y;
         printstr("Os valores obtidos foram: y = ");
         printfloat(y);
         printstr(", x = ");
         printint(x);
         printline("")
      end
end