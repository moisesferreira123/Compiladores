program swapexemple
begin
  procedure swap (a: ref(int), b: ref(int))
    begin
      var tmp: int
    in
      tmp := deref(a);
      deref(a) := deref(b);
      deref(b) := tmp
    end;
  procedure main()
    begin
      var x_: int;
      var y: int;
      var xr: ref(int);
      var yr: ref(int)
    in
      x_ := 42; y := 84;
      if x_ = y then
        x_ := -x_ + y
      else 
        x_ := x_^y;
        x_ := x_*y
      fi;
      xr := ref(x_); yr := ref(y);
      swap(xr,yr)
    end
end