program validate3
begin
   procedure add(a: int, b: int): int
   begin
      if a <= b then
         if a = b then
            return a * b
         else
            return b - a
         fi
      else
         return a + b
      fi
   end;
   procedure main()
      begin
         var x: int;
         var y: int;
         var z: int
      in
         x := readint();
         y := readint();
         z := add(x, y);
         printstr("O valor da soma é: ");
         printint(z)
      end
end